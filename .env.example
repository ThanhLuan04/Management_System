# Cấu hình cho docker compose (KHÔNG commit file .env thật).
# Phát triển trên máy không dùng file này — xem backend/.env.example.

# Mật khẩu database: chỉ dùng chữ, số, '-' và '_' (nằm trong URL kết nối, không phải mã hóa ký tự đặc biệt)
POSTGRES_PASSWORD=CHANGE_ME

# Khóa ký JWT — sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME

# Chạy thử trên máy (HTTP):
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
# Deploy có tên miền (Caddy tự lấy chứng chỉ HTTPS; tên miền phải trỏ về máy chủ, mở cổng 80 và 443):
# SITE_ADDRESS=shop.example.com
# PUBLIC_URL=https://shop.example.com

# production: tắt Swagger, không cho chạy dữ liệu demo. Đặt development nếu muốn thử với dữ liệu demo.
ENVIRONMENT=production

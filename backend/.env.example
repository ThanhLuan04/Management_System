# Copy file này thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.

# development | test | production
ENVIRONMENT=development

# Mật khẩu chỉ dùng chữ, số, '-' và '_' (để không phải URL-encode)
DATABASE_URL=postgresql+psycopg://smartstore:CHANGE_ME@localhost:5432/smartstore_dev
TEST_DATABASE_URL=postgresql+psycopg://smartstore:CHANGE_ME@localhost:5432/smartstore_test

# Danh sách origin frontend được phép gọi API, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Khóa ký JWT — sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME

# Gửi email mã "Quên mật khẩu" qua Gmail (tùy chọn):
#   1. Tài khoản Google bật Xác minh 2 bước
#   2. https://myaccount.google.com/apppasswords → tạo "Mật khẩu ứng dụng" (16 ký tự) → điền vào SMTP_PASSWORD
# Bỏ trống SMTP_HOST: môi trường development in mã ra cửa sổ backend để thử (production thì không gửi được).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
